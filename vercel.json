{
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/odoo/index.html",
      "destination": "/odoo/",
      "permanent": true
    },
    {
      "source": "/qlik/index.html",
      "destination": "/qlik/",
      "permanent": true
    },
    {
      "source": "/avisodeprivacidad/index.html",
      "destination": "/avisodeprivacidad/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</organization.jsonld>; rel=\"describedby\"; type=\"application/ld+json\", </avisodeprivacidad/>; rel=\"privacy-policy\""
        }
      ]
    },
    {
      "source": "/organization.jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json; charset=utf-8"
        }
      ]
    }
  ]
}
