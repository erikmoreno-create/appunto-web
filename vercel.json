{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</organization.jsonld>; rel=\"describedby\"; type=\"application/ld+json\", </avisodeprivacidad/>; rel=\"privacy-policy\""
        }
      ]
    },
    {
      "source": "/organization.jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/probe.md"
    },
    {
      "source": "/soluciones.html",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/probe.md"
    }
  ]
}
